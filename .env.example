# Trader agent — pick ONE provider (default: ollama)

# ollama | groq | gemini | rules
TRADER_AGENT_PROVIDER=ollama

# Ollama (local, free) — install from https://ollama.com
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Groq (free cloud) — https://console.groq.com
# GROQ_API_KEY=your_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (free tier) — https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-2.0-flash

# Alpaca market data (free Basic plan) — https://alpaca.markets
# Used for US stocks/ETFs (prices, news, search); Yahoo covers everything else.
# Paper-account keys work. Both values are required.
# ALPACA_API_KEY=PK...
# ALPACA_API_SECRET=...
